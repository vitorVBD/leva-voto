# Vazio: o navegador chama /api neste mesmo site.
NEXT_PUBLIC_API_URL=

# Em next dev, DATABASE_URL vazio guarda tudo em memória.
# Em produção o processo recusa subir sem Postgres e sem ADMIN_TOKEN
# de pelo menos 16 caracteres, diferente de dev-admin.
DATABASE_URL=
ADMIN_TOKEN=dev-admin
ENABLE_RIDE_FEATURE=false
ELECTION_AT=2026-10-25T08:00:00-03:00
ELECTION_END=2026-10-25T17:00:00-03:00
TSE_CACHE_DIR=
